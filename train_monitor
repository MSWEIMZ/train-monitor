#!/usr/bin/env python3
"""train_monitor: 向后兼容别名，实际调用trainbot"""
import sys
import os
import shutil

trainbot_path = shutil.which('trainbot')
if trainbot_path:
    os.execv(sys.executable, [sys.executable, trainbot_path] + sys.argv[1:])
else:
    # 尝试同目录
    local_trainbot = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'trainbot')
    if os.path.exists(local_trainbot):
        os.execv(sys.executable, [sys.executable, local_trainbot] + sys.argv[1:])
    else:
        print("错误: 找不到trainbot，请确保trainbot已安装")
        print("安装: wget https://raw.githubusercontent.com/MSWEIMZ/train-monitor/main/trainbot -O ~/.local/bin/trainbot")
        sys.exit(1)

def now_beijing():
    """获取当前北京时间"""
    return datetime.now(TZ_BEIJING)


def ensure_config_dir():
    """确保配置目录存在"""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)


def log_message(msg, level="INFO"):
    """写入日志文件"""
    ensure_config_dir()
    ts = now_beijing().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] [{level}] {msg}\n"
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(line)
    except Exception:
        pass


def detect_user():
    """自动检测当前用户名"""
    return (
        os.getenv("USER")
        or os.getenv("LOGNAME")
        or subprocess.run(["whoami"], capture_output=True, text=True).stdout.strip()
        or "unknown"
    )


# === Configuration Management ===


def load_config():
    """加载配置，与DEFAULT_CONFIG合并以处理新增字段"""
    config = dict(DEFAULT_CONFIG)
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                saved = json.load(f)
            config.update(saved)
        except (json.JSONDecodeError, OSError):
            pass
    return config


def save_config(config):
    """保存配置到文件"""
    ensure_config_dir()
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)


def get_webhook(config, notify_type="complete"):
    """获取webhook URL

    Args:
        config: 配置字典
        notify_type: 通知类型 ('complete' | 'anomaly')
    """
    if config.get("webhook_type") == "custom" and config.get("webhook_custom"):
        return config["webhook_custom"]
    return config.get("webhook_url", "")


def mask_webhook(url):
    """掩码webhook URL，只显示前30和后10个字符"""
    if not url:
        return "(未设置)"
    if len(url) <= 45:
        return url
    return url[:30] + "..." + url[-10:]



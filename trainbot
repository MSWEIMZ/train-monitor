# === Anomaly Detection ===


def check_anomaly(loss_history, threshold=None, config=None):
    """检测loss突增（当前loss相比上一个值超过阈值倍数）

    Args:
        loss_history: loss值列表
        threshold: 突增倍数阈值（默认从config读取）
        config: 配置字典

    Returns:
        (is_anomaly, spike_ratio) 元组
    """
    if not loss_history or len(loss_history) < 2:
        return False, 0.0

    if threshold is None:
        if config is None:
            config = DEFAULT_CONFIG
        threshold = config.get("anomaly_loss_spike", 2.0)

    prev = loss_history[-2]
    curr = loss_history[-1]

    if prev <= 0:
        return False, 0.0

    ratio = curr / prev
    return ratio > threshold, ratio


def check_acc_anomaly(acc_history, threshold=None, config=None):
    """检测准确率下降（当前acc相比上一个值下降超过阈值）

    Args:
        acc_history: 准确率值列表
        threshold: 下降绝对值阈值（默认从config读取）
        config: 配置字典

    Returns:
        (is_anomaly, drop_amount) 元组
    """
    if not acc_history or len(acc_history) < 2:
        return False, 0.0

    if threshold is None:
        if config is None:
            config = DEFAULT_CONFIG
        threshold = config.get("anomaly_acc_drop", 0.1)

    prev = acc_history[-2]
    curr = acc_history[-1]
    drop = prev - curr

    return drop > threshold, drop


def check_nan(values):
    """检测列表中是否有NaN或Inf

    Args:
        values: 数值列表

    Returns:
        bool: 是否包含NaN或Inf
    """
    for v in values:
        if v is None:
            continue
        if isinstance(v, (int, float)):
            if math.isnan(v) or math.isinf(v):
                return True
    return False


# === Process Discovery ===


def get_gpu_processes():
    """获取当前用户的GPU训练进程

    两遍检测:
    1. 找bash nohup进程（含CUDA_VISIBLE_DEVICES和train关键词）
    2. 找python子进程，从父进程继承GPU信息
    """
    try:
        user = detect_user()
        result = subprocess.run(
            ["ps", "-u", user, "-o", "pid,ppid,stat,args"],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            return []

        processes = []
        seen_pids = set()

        # 第一遍：找bash nohup进程（包含CUDA_VISIBLE_DEVICES和train）
        bash_train_processes = {}
        for line in result.stdout.split("\n"):
            if "CUDA_VISIBLE_DEVICES" in line and ("train" in line or "epoch" in line):
                parts = line.split(None, 3)
                if len(parts) >= 4:
                    pid, ppid, stat, cmdline = parts[0], parts[1], parts[2], parts[3]
                    cuda_match = re.search(r"CUDA_VISIBLE_DEVICES[= ](\d+)", cmdline)
                    if cuda_match:
                        bash_train_processes[pid] = cuda_match.group(1)

        # 第二遍：找python训练进程
        for line in result.stdout.split("\n"):
            if not re.search(r"^\s*\d+\s+\d+\s+\S+\s+python", line):
                continue

            parts = line.split(None, 3)
            if len(parts) < 4:
                continue

            pid, ppid, stat, cmdline = parts[0], parts[1], parts[2], parts[3]

            # 只看正在运行的进程（R=运行，S=睡眠等待）
            if stat[0] not in ("R", "S"):
                continue

            # 跳过非训练进程
            if any(x in cmdline.lower() for x in ["mcp", "minimax", "cache", "uv"]):
                continue

            # 必须包含train相关关键词
            if not any(x in cmdline.lower() for x in ["train", "epoch", "fold"]):
                continue

            # 提取GPU信息
            gpu_id = "?"
            cuda_match = re.search(r"CUDA_VISIBLE_DEVICES[= ](\d+)", cmdline)
            device_match = re.search(r"--device[= ](cuda:\d+)", cmdline)

            if cuda_match:
                gpu_id = cuda_match.group(1)
            elif device_match:
                gpu_id = device_match.group(1).replace("cuda:", "")
            elif ppid in bash_train_processes:
                gpu_id = bash_train_processes[ppid]

            # 只显示主进程（有GPU信息的，或是train_*.py脚本）
            if gpu_id == "?":
                if not re.search(r"train_\w+\.py", cmdline):
                    continue

            # 提取实验名
            exp_name = extract_exp_name(cmdline)

            # 获取日志路径
            log_path = get_log_path(pid)

            processes.append(
                {
                    "pid": pid,
                    "gpu": f"cuda:{gpu_id}" if gpu_id != "?" else "?",
                    "exp_name": exp_name,
                    "log_path": log_path,
                    "cmdline": cmdline,
                }
            )

        return processes
    except Exception:
        return []


def extract_exp_name(cmdline):
    """从命令行提取实验名

    优先从脚本名提取，其次从--name参数提取。
    """
    # 提取脚本名
    match = re.search(r"(?:python\S*?|python3)\s+(\S+\.py)", cmdline)
    if match:
        script = Path(match.group(1)).stem
        # 简化名称：去掉train_前缀
        script = re.sub(r"^train_", "", script)
        return script

    # 尝试提取--name参数
    match = re.search(r"--name[= ](\S+)", cmdline)
    if match:
        return match.group(1)

    return "unknown"


def get_log_path(pid):
    """获取进程的日志文件路径

    通过/proc/{pid}/fd/1和fd/2获取stdout/stderr指向的文件。
    """
    try:
        # 尝试从stdout获取
        log_path = os.readlink(f"/proc/{pid}/fd/1")
        if not log_path.startswith("/dev/"):
            return log_path

        # 尝试从stderr获取
        log_path = os.readlink(f"/proc/{pid}/fd/2")
        if not log_path.startswith("/dev/"):
            return log_path

        return None
    except Exception:
        return None


# === Log Parsing ===


def extract_description(lines):
    """从日志开头提取实验描述

    在=====之间的块中找描述行，如果没有则找Training开头的行。
    """
    in_block = False
    desc_lines = []
    for line in lines:
        line = line.strip()
        if "=====" in line:
            if in_block:
                break
            in_block = True
            continue
        if in_block and line and not line.startswith("Changes") and not line.startswith("-"):
            desc_lines.append(line)
            if len(desc_lines) >= 1:
                break

    if desc_lines:
        return desc_lines[0][:50]

    # 如果没有===块，找Training开头的行
    for line in lines:
        line = line.strip()
        if line.startswith("Training"):
            return line[:50]

    return None


# 6种内置正则模式
BUILTIN_PATTERNS = [
    # 格式1: Epoch 12/50 | Train 0.6348 0.9998 | Val 0.8152 0.8008 0.7750
    {
        "name": "epoch_val_acc_mf1",
        "regex": r"Epoch\s+(\d+)/(\d+).*?Val\s+[\d.]+\s+([\d.]+)\s+([\d.]+)",
        "groups": {"current": 1, "total": 2, "val_acc": 3, "val_mf1": 4},
    },
    # 格式2: Ep 001 [LR: 1.15e-05] | Train Loss 2.795 Acc 0.061 | Val Loss 2.648 Acc 0.158 | MF1 0.077
    {
        "name": "ep_val_acc_mf1",
        "regex": r"Ep\s+(\d+).*?Val Loss\s+[\d.]+\s+Acc\s+([\d.]+).*?MF1\s+([\d.]+)",
        "groups": {"current": 1, "val_acc": 2, "val_mf1": 3},
    },
    # 格式3: Epoch 12 | val_loss=0.112
    {
        "name": "epoch_val_loss",
        "regex": r"Epoch\s+(\d+).*?val_loss[=:]\s*([\d.]+)",
        "groups": {"current": 1, "val_loss": 2},
    },
    # 格式4: Epoch 39/50 | Train 0.1291 | Val 0.1033 (蒸馏loss)
    {
        "name": "epoch_val_distill",
        "regex": r"Epoch\s+(\d+)/(\d+).*?Val\s+([\d.]+)",
        "groups": {"current": 1, "total": 2, "val_loss": 3},
    },
    # 格式5: loss=0.1234 (简单loss格式)
    {
        "name": "simple_loss",
        "regex": r"loss[=:]\s*([\d.]+)",
        "groups": {"val_loss": 1},
    },
    # 格式6: [Epoch 5] train_loss=0.5 val_loss=0.3
    {
        "name": "bracket_epoch",
        "regex": r"\[Epoch\s+(\d+)\].*?val_loss[=:]\s*([\d.]+)",
        "groups": {"current": 1, "val_loss": 2},
    },
]


def parse_training_log(log_path):
    """解析训练日志，提取最新epoch信息和实验描述

    依次尝试6种内置正则模式，返回第一个匹配的结果。
    """
    if not log_path or not os.path.exists(log_path):
        return None

    try:
        with open(log_path, "r", errors="ignore") as f:
            lines = f.readlines()
            last_lines = lines[-100:] if len(lines) > 100 else lines

        # 提取实验描述（从开头几行）
        desc = extract_description(lines[:30])

        # 依次尝试每种模式
        for line in reversed(last_lines):
            line = line.strip()
            if not line:
                continue

            for pattern in BUILTIN_PATTERNS:
                match = re.search(pattern["regex"], line)
                if match:
                    info = {"trend": "↑" if "★" in line else "→", "desc": desc}
                    groups = pattern["groups"]

                    for field, group_idx in groups.items():
                        val = match.group(group_idx)
                        if field == "current":
                            info["current"] = int(val)
                        elif field == "total":
                            info["total"] = int(val)
                        elif field in ("val_acc", "val_mf1"):
                            info[field] = float(val)
                        elif field == "val_loss":
                            info["val_loss"] = float(val)

                    # 格式3/5/6没有★标记，用loss下降判断
                    if "★" not in line:
                        info["trend"] = "→"

                    return info

        return None

    except Exception:
        return None


def parse_custom_log(log_path, patterns):
    """使用用户自定义正则解析日志

    Args:
        log_path: 日志文件路径
        patterns: 自定义正则模式列表，每项为 {"name": ..., "regex": ..., "groups": ...}

    Returns:
        解析结果字典或None
    """
    if not log_path or not os.path.exists(log_path) or not patterns:
        return None

    try:
        with open(log_path, "r", errors="ignore") as f:
            lines = f.readlines()
            last_lines = lines[-100:] if len(lines) > 100 else lines

        desc = extract_description(lines[:30])

        for line in reversed(last_lines):
            line = line.strip()
            if not line:
                continue

            for pattern in patterns:
                match = re.search(pattern.get("regex", ""), line)
                if match:
                    info = {"trend": "→", "desc": desc}
                    groups = pattern.get("groups", {})
                    for field, group_idx in groups.items():
                        try:
                            val = match.group(int(group_idx))
                            if field in ("current", "total"):
                                info[field] = int(val)
                            elif field in ("val_acc", "val_mf1", "val_loss", "train_loss"):
                                info[field] = float(val)
                            else:
                                info[field] = val
                        except (IndexError, ValueError):
                            pass
                    return info

        return None

    except Exception:
        return None


# === Status Display ===


def get_processes_from_logdir(log_dir):
    """从日志目录获取进程信息（logdir模式）

    扫描目录下的.log文件，解析最新状态。
    """
    if not log_dir or not os.path.isdir(log_dir):
        return []

    processes = []
    for f in sorted(Path(log_dir).glob("*.log")):
        exp_name = f.stem
        processes.append(
            {
                "pid": None,
                "gpu": "?",
                "exp_name": exp_name,
                "log_path": str(f),
                "cmdline": "",
            }
        )
    return processes


def show_status(config=None):
    """显示当前训练状态

    这是主显示函数，格式与train_monitor一致但带有trainbot头部。
    支持多种监控模式。
    """
    if config is None:
        config = load_config()

    mode = config.get("monitor_mode", "auto")

    # 根据模式获取进程列表
    if mode == "logdir" and config.get("log_dir"):
        gpu_processes = get_processes_from_logdir(config["log_dir"])
    elif mode == "manual" and config.get("log_dir"):
        gpu_processes = get_processes_from_logdir(config["log_dir"])
    else:
        gpu_processes = get_gpu_processes()

    if not gpu_processes:
        print()
        print("  没有发现正在运行的训练进程")
        print()
        return

    # 去重：同一日志文件只显示一次
    seen_logs = set()
    unique_processes = []
    for p in gpu_processes:
        log_key = p["log_path"] or p["pid"]
        if log_key not in seen_logs:
            seen_logs.add(log_key)
            unique_processes.append(p)

    # 输出表格（北京时间）
    now = now_beijing().strftime("%Y-%m-%d %H:%M:%S")
    print(f"══════════════════════════════════════════════════════════════════════════════")
    print(f"  trainbot v{VERSION}   {now}")
    print(f"══════════════════════════════════════════════════════════════════════════════")
    print()
    print(
        f"  {'Experiment':<20} {'GPU':<8} {'Epoch':<10} {'Val Acc':<10} {'Val MF1':<10} {'Description':<30}"
    )
    print(f"  {'─'*20} {'─'*8} {'─'*10} {'─'*10} {'─'*10} {'─'*30}")

    for t in unique_processes:
        exp_name = t["exp_name"][:20]
        gpu = t["gpu"]

        if t["log_path"]:
            # 尝试内置模式解析
            info = parse_training_log(t["log_path"])
            # 如果内置模式没有匹配，尝试自定义正则
            if not info and config.get("custom_patterns"):
                info = parse_custom_log(t["log_path"], config["custom_patterns"])

            if info:
                epoch = (
                    f"{info['current']}/{info['total']}"
                    if info.get("total")
                    else str(info.get("current", "?"))
                )
                # 优先显示acc，没有则显示loss
                if info.get("val_acc"):
                    val_acc = f"{info['val_acc']*100:.1f}%"
                elif info.get("val_loss"):
                    val_acc = f"loss:{info['val_loss']:.3f}"
                else:
                    val_acc = "-"
                val_mf1 = f"{info['val_mf1']*100:.1f}%" if info.get("val_mf1") else "-"
                desc = info.get("desc", "-") or "-"
            else:
                epoch = "?"
                val_acc = "-"
                val_mf1 = "-"
                desc = "-"
        else:
            epoch = "?"
            val_acc = "-"
            val_mf1 = "-"
            desc = "-"

        print(f"  {exp_name:<20} {gpu:<8} {epoch:<10} {val_acc:<10} {val_mf1:<10} {desc:<30}")

    print()


# === CLI Entry Point ===


def print_help():
    """打印帮助信息"""
    print(f"trainbot v{VERSION} - GPU训练监控+钉钉告警工具")
    print()
    print("用法:")
    print("  trainbot              显示当前训练状态")
    print("  trainbot status       同上")
    print("  trainbot setup        交互式配置向导")
    print("  trainbot config       查看当前配置")
    print("  trainbot --help       显示此帮助信息")
    print("  trainbot --version    显示版本号")
    print()
    print("配置文件: ~/.trainbot/config.json")
    print()


def main():
    """主入口"""
    args = sys.argv[1:]

    if not args or args[0] in ("status",):
        show_status()
    elif args[0] in ("--help", "-h", "help"):
        print_help()
    elif args[0] in ("--version", "-v"):
        print(f"trainbot v{VERSION}")
    elif args[0] == "setup":
        setup_wizard()
    elif args[0] == "config":
        config = load_config()
        print_config(config)
    elif args[0] == "daemon":
        print("  daemon 模式尚未实现（将在后续版本中添加）")
    else:
        print(f"  未知命令: {args[0]}")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()

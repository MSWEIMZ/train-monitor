def import_config(filepath):
    """导入配置"""
    if not os.path.exists(filepath):
        print(f"✗ 文件不存在: {filepath}")
        return
    try:
        with open(filepath, 'r') as f:
            imported = json.load(f)
    except json.JSONDecodeError as e:
        print(f"✗ JSON格式错误: {e}")
        return
    config = load_config()
    for key in imported:
        if isinstance(imported[key], dict) and key in config and isinstance(config[key], dict):
            config[key].update(imported[key])
        else:
            config[key] = imported[key]
    save_config(config)
    print(f"✓ 配置已导入到 {CONFIG_FILE}")


# === Update / Uninstall ===


def check_update():
    """检查更新"""
    try:
        req = urllib.request.Request(GITHUB_RAW)
        with urllib.request.urlopen(req, timeout=10) as resp:
            content = resp.read().decode()
        m = re.search(r'VERSION\s*=\s*"(\d+\.\d+\.\d+)"', content)
        if m:
            remote = m.group(1)
            if remote != VERSION:
                print(f"当前版本: v{VERSION}")
                print(f"最新版本: v{remote}")
                print("运行 trainbot update 进行更新")
            else:
                print(f"✓ 已是最新版本 (v{VERSION})")
        else:
            print("无法解析远程版本号")
    except Exception as e:
        print(f"检查更新失败: {e}")


def do_update():
    """更新到最新版本"""
    print("下载最新版本...")
    try:
        import shutil
        req = urllib.request.Request(GITHUB_RAW)
        with urllib.request.urlopen(req, timeout=30) as resp:
            new_content = resp.read()
        # 备份
        backup_dir = CONFIG_DIR / "backup"
        backup_dir.mkdir(parents=True, exist_ok=True)
        backup_path = backup_dir / f"trainbot_v{VERSION}"
        shutil.copy2(sys.argv[0], backup_path)
        print(f"已备份: {backup_path}")
        # 写入
        script_path = Path(sys.argv[0])
        with open(script_path, 'wb') as f:
            f.write(new_content)
        os.chmod(script_path, 0o755)
        print("✓ 更新完成！")
    except Exception as e:
        print(f"更新失败: {e}")


def do_uninstall(keep_config=False):
    """卸载"""
    print("确认卸载 trainbot? (y/n): ", end='')
    if input().strip().lower() != 'y':
        print("取消卸载")
        return
    if is_daemon_running():
        stop_daemon()
    script_path = Path(sys.argv[0])
    if script_path.exists():
        script_path.unlink()
        print(f"已删除: {script_path}")
    if not keep_config and CONFIG_DIR.exists():
        import shutil
        shutil.rmtree(CONFIG_DIR)
        print(f"已删除配置: {CONFIG_DIR}")
    print("✓ 卸载完成")



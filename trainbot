#!/usr/bin/env python3
"""trainbot: GPU训练监控+钉钉告警工具

单文件实现，零外部依赖（仅stdlib），Python 3.8+兼容。

功能:
  - 自动发现GPU训练进程
  - 解析训练日志（epoch/loss/acc）
  - 钉钉webhook告警（训练完成/异常检测）
  - 后台守护进程持续监控
  - 兼容原 tm 命令

用法:
  trainbot              # 显示当前训练状态
  trainbot status       # 同上
  trainbot setup        # 交互式配置
  trainbot config       # 查看当前配置
  trainbot daemon start # 启动后台监控
  trainbot daemon stop  # 停止后台监控
  trainbot --help       # 帮助信息
  trainbot --version    # 版本号
"""


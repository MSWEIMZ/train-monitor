            if is_daemon_running():
                with open(PID_FILE, 'r') as f:
                    print(f"✓ 后台监控运行中 (PID: {f.read().strip()})")
            else:
                print("后台监控未运行")
        else:
            start_daemon(config)
    elif args[0] == "history":
        show_all = "--all" in args
        clear = "--clear" in args
        show_history(show_all=show_all, clear=clear)
    elif args[0] == "export":
        output = None
        if "--output" in args:
            idx = args.index("--output")
            if idx + 1 < len(args):
                output = args[idx + 1]
        export_config(output)
    elif args[0] == "import":
        if len(args) < 2:
            print("用法: trainbot import <文件路径>")
            sys.exit(1)
        import_config(args[1])
    elif args[0] == "log":
        if "--clear" in args:
            show_log(clear=True)
        elif "--tail" in args:
            idx = args.index("--tail")
            if idx + 1 < len(args):
                show_log(tail=args[idx + 1])
            else:
                print("用法: trainbot log --tail <行数>")
                sys.exit(1)
        else:
            show_log()
    elif args[0] == "update":
        do_update()
    elif args[0] == "check-update":
        check_update()
    elif args[0] == "uninstall":
        keep_config = "--keep-config" in args
        do_uninstall(keep_config=keep_config)
    elif args[0] == "set-webhook":
        if len(args) < 2:
            print("用法: trainbot set-webhook <URL>")
            sys.exit(1)
        batch_set_webhook(args[1])
    elif args[0] == "set-alert":
        if len(args) < 2:
            print("用法: trainbot set-alert <true/false>")
            sys.exit(1)
        batch_set_alert(args[1])
    elif args[0] == "set-interval":
        if len(args) < 2:
            print("用法: trainbot set-interval <小时数>")
            sys.exit(1)
        batch_set_interval(args[1])
    else:
        print(f"  未知命令: {args[0]}")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()

# === Daemon Mode ===


def load_notified_pids():
    if NOTIFIED_FILE.exists():
        try:
            with open(NOTIFIED_FILE, 'r') as f:
                return set(json.load(f).get("notified_pids", []))
        except Exception:
            pass
    return set()


def save_notified_pids(pids):
    ensure_config_dir()
    with open(NOTIFIED_FILE, 'w') as f:
        json.dump({"notified_pids": list(pids), "last_update": now_beijing().isoformat()}, f, indent=2)


def is_daemon_running():
    if not PID_FILE.exists():
        return False
    try:
        with open(PID_FILE, 'r') as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, ValueError, PermissionError):
        PID_FILE.unlink(missing_ok=True)
        return False


def stop_daemon():
    if not PID_FILE.exists():
        print("后台监控未运行")
        return
    try:
        with open(PID_FILE, 'r') as f:
            pid = int(f.read().strip())
        os.kill(pid, signal.SIGTERM)
        print(f"✓ 已停止后台监控 (PID: {pid})")
    except ProcessLookupError:
        print("后台监控进程已不存在")
    except Exception as e:
        print(f"停止失败: {e}")
    finally:
        PID_FILE.unlink(missing_ok=True)


def start_daemon(config):
    """启动后台监控"""
    if is_daemon_running():
        print("后台监控已在运行")
        return
    ensure_config_dir()
    with open(PID_FILE, 'w') as f:
        f.write(str(os.getpid()))
    log_message("后台监控启动")
    print(f"✓ 后台监控已启动 (PID: {os.getpid()})")

    loss_history = {}
    acc_history = {}
    last_report_time = 0
    notified_pids = load_notified_pids()

    try:
        while True:
            try:
                processes = get_gpu_processes()
                for p in processes:
                    pid = p['pid']
                    if p['log_path']:
                        info = parse_training_log(p['log_path'])
                        if info:
                            info['exp_name'] = p['exp_name']
                            info['gpu'] = p['gpu']
                            if pid not in loss_history:
                                loss_history[pid] = []
                                acc_history[pid] = []
                            if info.get('val_loss') is not None:
                                loss_history[pid].append(info['val_loss'])
                            if info.get('val_acc') is not None:
                                acc_history[pid].append(info['val_acc'])
                            # Anomaly detection
                            alerts = []
                            if config.get("alert", True):
                                thresholds = config.get("alert_thresholds", {})
                                if info.get('val_loss') is not None:
                                    r = check_anomaly(loss_history[pid], config=config)
                                    if r[0]:
                                        alerts.append(f"Loss突增: {r[1]:.2f}x")
                                if info.get('val_acc') is not None:
                                    r = check_acc_anomaly(acc_history[pid], config=config)
                                    if r[0]:
                                        alerts.append(f"Acc下降: {r[1]:.4f}")
                            for alert_msg in alerts:
                                info['alert_reason'] = alert_msg
                                webhook = get_webhook(config, "alert")
                                msg = format_notification(info, "alert", config.get("format", "detailed"))
                                ok, _ = send_dingtalk(webhook, msg)
                                record_history("alert", info, success=ok)
                                log_message(f"告警: {alert_msg}")
                            # Completion detection
                            if info.get('total') and info['current'] >= info['total']:
                                if pid not in notified_pids:
                                    webhook = get_webhook(config, "complete")
                                    msg = format_notification(info, "complete", config.get("format", "detailed"))
                                    ok, _ = send_dingtalk(webhook, msg)
                                    if ok:
                                        notified_pids.add(pid)
                                        save_notified_pids(notified_pids)
                                    record_history("complete", info, success=ok)
                                    log_message(f"训练完成: {info['exp_name']}")
                # Periodic report
                interval = config.get("interval_hours", 0)
                if interval > 0 and time.time() - last_report_time >= interval * 3600:
                    if processes:
                        infos = []
                        for p in processes:
                            info = parse_training_log(p['log_path']) if p['log_path'] else {}
                            if info:
                                info['exp_name'] = p['exp_name']
                                info['gpu'] = p['gpu']
                                infos.append(info)
                        if infos:
                            webhook = get_webhook(config, "report")
                            msg = format_multi_notification(infos, "report", config.get("format", "detailed"))
                            send_dingtalk(webhook, msg)
                            last_report_time = time.time()
            except Exception as e:
                log_message(f"监控周期异常: {e}", "ERROR")
            if not is_daemon_running():
                break
            time.sleep(60)
    except KeyboardInterrupt:
        log_message("后台监控被中断")
    finally:
        stop_daemon()


# === Status Display ===


def get_processes_from_logdir(log_dir):
    """从日志目录获取进程信息（logdir模式）

    扫描目录下的.log文件，解析最新状态。
    """
    if not log_dir or not os.path.isdir(log_dir):
        return []

    processes = []
    for f in sorted(Path(log_dir).glob("*.log")):
        exp_name = f.stem
        processes.append(
            {
                "pid": None,
                "gpu": "?",
                "exp_name": exp_name,
                "log_path": str(f),
                "cmdline": "",
            }
        )
    return processes


